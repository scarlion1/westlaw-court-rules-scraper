# ============================================================
# Westlaw Court Rules Scraper — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# Abacus.AI API key (only needed for email notifications on scrape completion/failure)
# Set to any placeholder string to disable notifications.
ABACUSAI_API_KEY=your-abacusai-api-key-here

# Abacus.AI web app ID (notification routing - leave blank to disable)
WEB_APP_ID=

# Notification template IDs (leave blank to disable email notifications)
NOTIF_ID_SCRAPE_COMPLETED=
NOTIF_ID_SCRAPE_FAILED=
